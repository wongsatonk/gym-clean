{
  "name": "gym-clean",
  "version": "0.0.0",
  "description": "Phone-first workout focus app",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:scripts",
    "e2e": "playwright test",
    "landmarks": "node scripts/landmarks.mjs",
    "postinstall": "node scripts/copy-mediapipe-wasm.mjs",
    "synthetic": "node scripts/synthetic.mjs",
    "devlog": "node scripts/devlog.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "dexie": "^4.4.7",
    "three": "^0.187.0"
  }
}
